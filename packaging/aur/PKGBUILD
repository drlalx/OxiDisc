# Maintainer: Alexander Drichel
pkgname=oxidisc
pkgver=2.0.0
pkgrel=1
pkgdesc="Modern and fast audio CD ripper in Rust with egui GUI and Ratatui TUI"
arch=('x86_64')
url="https://github.com/dral/OxiDisc"
license=('MIT')
depends=(
  'cdparanoia'
  'cd-discid'
  'eject'
  'flac'
  'lame'
  'libdiscid'
  'opus-tools'
  'vorbis-tools'
)
makedepends=(
  'cargo'
  'git'
  'pkgconf'
)
source=("${pkgname}::git+https://github.com/dral/OxiDisc.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "${pkgname}"
  cargo build --release --locked --features "egui-ui tui"
}

check() {
  cd "${pkgname}"
  cargo test --locked --features "egui-ui tui"
}

package() {
  cd "${pkgname}"

  install -Dm755 "target/release/oxidisc" \
    "${pkgdir}/usr/bin/oxidisc"
  install -Dm644 "resources/oxidisc.desktop" \
    "${pkgdir}/usr/share/applications/oxidisc.desktop"
  install -Dm644 "resources/images/oxidisc.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/io.github.dral.oxidisc.png"
  install -Dm644 "resources/metainfo/io.github.dral.oxidisc.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.github.dral.oxidisc.metainfo.xml"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
